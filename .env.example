# ──────────────────────────────────────────────────────────────────────────────
# UNIIVERSE environment variables
#
# Local development: copy this file to `.env.local` (never committed) and fill in what you have.
# Production (Vercel): add the same names under Project → Settings → Environment Variables.
# Nothing here is required to explore the app in demo mode.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Leave empty locally to use the embedded database (./.data, demo mode).
# Production: your Supabase connection string (Project → Connect → Transaction pooler, port 6543).
DATABASE_URL=
# Optional: max pooled connections per server instance (default 5).
DATABASE_POOL_MAX=
# Optional TLS override: require | prefer | verify-full | disable. Hosted databases (Supabase,
# Neon, Railway…) get "require" automatically; local Postgres gets none.
DATABASE_SSL=

# ── Accounts and sessions (required in production) ───────────────────────────
# Signs login sessions. Any long random string: openssl rand -hex 32
UNIIVERSE_AUTH_SECRET=
# Setup and recovery key: the first visit to a production deployment asks for it to create the
# owner account, and /recover asks for it when the owner forgot their username or password.
# Keep it set. Members sign in with their own username + password and join by invite.
# Session length in days: a normal sign-in, and "Remember this device". Defaults 30 and 365.
UNIIVERSE_SESSION_DAYS=30
UNIIVERSE_SESSION_REMEMBER_DAYS=365
UNIIVERSE_ACCESS_PASSWORD=
# Accounts are required automatically on any Vercel deployment and on any production server that
# has a DATABASE_URL. Set "true" to force accounts elsewhere; "false" only for a private LAN server.
UNIIVERSE_REQUIRE_AUTH=

# ── Automation ───────────────────────────────────────────────────────────────
# Secret that schedulers (Vercel Cron, GitHub Actions, cron-job.org…) send to /api/jobs/*.
CRON_SECRET=
# Soft time budget per job run in milliseconds (keep below your host's function timeout).
UNIIVERSE_JOB_BUDGET_MS=240000
# Set "true" to log Postgres NOTICE messages (off by default to keep production logs clean).
UNIIVERSE_DB_NOTICES=

# ── Riot Games API (ranked statistics + linked accounts) ─────────────────────
# Get a key at https://developer.riotgames.com (development keys expire daily;
# register a "Personal API key" for a persistent one). Server-side only, never shown.
RIOT_API_KEY=
# Servers to collect ranked statistics from. "all" = every public League platform (recommended):
# br1, eun1, euw1, jp1, kr, la1, la2, na1, oc1, tr1, ru, me1, sg2, ph2, th2, tw2, vn2.
# A comma-separated list of platform ids or regional shorthands (americas, europe, asia, sea)
# also works. Default when unset: oc1.
RIOT_PLATFORMS=all
# Server the sign-up region selector starts on (a fallback: Riot confirms each account's real
# server during verification). Default: oc1.
RIOT_DEFAULT_PLATFORM=oc1
# Tiers to follow. Default: CHALLENGER,GRANDMASTER,MASTER
RIOT_TIERS=CHALLENGER,GRANDMASTER,MASTER
# Rate limits of your key as "requests:seconds" pairs, applied PER RIOT HOST (each platform and
# each regional routing host has its own budget). Default (development and personal keys):
# 20:1,100:120. A production key with higher limits: e.g. 500:10,30000:600.
RIOT_RATE_LIMITS=20:1,100:120
# Tuning (optional): players followed per tier, players scanned per run (shared fairly across
# regions), lookback window, matches fetched per run, ladders refreshed per run and how often.
RIOT_MAX_PLAYERS_PER_TIER=300
RIOT_MAX_PLAYERS_PER_RUN=40
RIOT_LOOKBACK_DAYS=7
RIOT_INGEST_BATCH=60
# Parallel regional ingestion workers (each holds one database connection; keep below the pool max).
RIOT_INGEST_CONCURRENCY=3
RIOT_LEAGUE_REFRESHES_PER_RUN=6
RIOT_LEAGUE_REFRESH_MINUTES=360
# Linked player/opponent accounts: accounts synced per run and minimum age between syncs.
ACCOUNT_SYNC_BATCH=10
ACCOUNT_SYNC_MIN_AGE_MINUTES=180

# ── Professional play data ───────────────────────────────────────────────────
# leaguepedia (default, automatic, includes pick order) | oracleselixir (CSV export) | none
PRO_DATA_PROVIDER=leaguepedia
# Leaguepedia rate-limits anonymous API clients (a cloud host is refused on the first request).
# Create a bot password at https://lol.fandom.com/wiki/Special:BotPasswords (read-only grants are
# enough); the username is written Account@BotName. Keep both out of chat, commits and the repo.
LEAGUEPEDIA_USERNAME=
LEAGUEPEDIA_PASSWORD=
# Only for oracleselixir: direct URL to the current-season CSV export.
PRO_DATA_CSV_URL=
PRO_LOOKBACK_DAYS=60
PRO_MAX_GAMES_PER_RUN=1500

# ── Realtime draft room (optional tuning) ────────────────────────────────────
# How often the live stream checks for changes (two small queries per check), and how long one
# stream lives before reconnecting.
UNIIVERSE_LIVE_POLL_MS=2000
UNIIVERSE_LIVE_LIFETIME_MS=240000

# ── Logging and diagnostics (optional) ───────────────────────────────────────
# Structured JSON logs. Level: debug | info | warn | error (default info in production).
UNIIVERSE_LOG_LEVEL=info
# Steps, actions and requests slower than these (ms) are logged as warnings.
UNIIVERSE_SLOW_STEP_MS=1500
UNIIVERSE_SLOW_ACTION_MS=800
UNIIVERSE_SLOW_REQUEST_MS=2000

# ── Misc ─────────────────────────────────────────────────────────────────────
# Seed demo players/statistics on first run. Default: true for the embedded DB, false for Postgres.
UNIIVERSE_SEED_DEMO=
# Data Dragon locale for champion names (default en_US).
DDRAGON_LOCALE=en_US
