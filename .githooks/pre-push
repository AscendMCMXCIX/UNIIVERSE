#!/bin/sh
# Blocks direct pushes to main. Changes reach main through a pull request (see CLAUDE.md and
# docs/CI_USAGE.md): branch protection is not available for private repositories on GitHub Free,
# so this is the guard. Merging a pull request on GitHub is not affected.
# A deliberate exception (for example an emergency fix): ALLOW_MAIN_PUSH=1 git push ...
[ "${ALLOW_MAIN_PUSH:-}" = "1" ] && exit 0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: pushing to main is blocked. Push a feature branch and open a pull request." >&2
    echo "pre-push: (deliberate exception: ALLOW_MAIN_PUSH=1 git push ...)" >&2
    exit 1
  fi
done
exit 0
